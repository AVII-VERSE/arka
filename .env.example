# ============================================================
# ARKA - Advanced Real-time Kinetic Analytics
# Environment Configuration Template
# ============================================================

# Environment Mode
ARKA_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=arka_user
POSTGRES_PASSWORD=arka_password_change_me
POSTGRES_DB=arka_db
DATABASE_URL=postgresql+asyncpg://arka_user:arka_password_change_me@localhost:5432/arka_db

# Apache Kafka Event Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS_RAW=arka.events.raw
KAFKA_TOPIC_EVENTS_NORMALIZED=arka.events.normalized
KAFKA_TOPIC_ALERTS=arka.alerts
KAFKA_TOPIC_AUDIT=arka.audit
KAFKA_TOPIC_DLQ=arka.events.dlq
KAFKA_CONSUMER_GROUP=arka-processor-group

# OpenSearch Storage
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=arka-events

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Keycloak / OAuth2 OIDC
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=arka
KEYCLOAK_CLIENT_ID=arka-backend
KEYCLOAK_CLIENT_SECRET=change-me

# ARKA Agent Configuration
ARKA_AGENT_SERVER_URL=http://localhost:8000
ARKA_AGENT_ENROLLMENT_TOKEN=change-me-enrollment-token
ARKA_AGENT_HEARTBEAT_INTERVAL=30
